    "node": ">=18"
  },
  "keywords": [
    "cli",
    "heatmap",
    "contribution-graph",
    "github-style",
    "claude-code",
    "claude",
    "codex",
    "opencode",
    "cursor",
    "ai",
    "ai-tools",
    "coding-assistant",
    "usage",
    "tokens",
    "statistics",
    "terminal",
    "developer-tools",
    "devtools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshkedia177/braggrid"
  },
  "homepage": "https://github.com/harshkedia177/braggrid#readme",
  "bugs": {
    "url": "https://github.com/harshkedia177/braggrid/issues"
  },
  "author": "Harsh Kedia",
  "dependencies": {
    "chalk": "^5.4.0",
    "clipboardy": "^4.0.0",
    "commander": "^13.0.0",
    "sharp": "^0.33.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.9",
    "typescript": "^5.7.0"
  }
